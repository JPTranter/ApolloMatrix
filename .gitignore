# ESPHome secrets (never commit real values)
secrets.yaml

# ESPHome build cache / generated files
.esphome/
*.bin
*.elf
*.map

# Device Builder local state
.device-builder*
.receiver_peers.json
.offloader_pairings.json

# Python / tooling
__pycache__/
*.py[cod]
.venv/
venv/

# Host test harness: build artefacts + rendered images (regenerate with
# test/run_tests.sh). test/fonts/ keeps metrics.json, NOTICE.txt and the OFL
# licence texts tracked; the .ttf files themselves are ignored — see the rule
# below and test/fonts/NOTICE.txt.
test/build/
test/output/

# Preview fonts are third-party and not distributed - fetch with
# `python test/fetch_fonts.py` (see test/fonts/NOTICE.txt).
test/fonts/*.ttf

# Editor / local tool state. The harness's CMake source dir is documented in the
# README, so a committed editor config would only carry one machine's preferences.
# Same rule as ChromaWOTD and GBOGH.
.vscode/

# OS noise
.DS_Store
Thumbs.db
